{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "大富翁4 重制版",
  "version": "0.1.0",
  "identifier": "com.rich4.remake",
  "build": {
    "frontendDist": "../../client/dist-web",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "pnpm --filter @rich4/client dev",
    "beforeBuildCommand": "pnpm --filter @rich4/client build"
  },
  "app": {
    "windows": [
      {
        "title": "大富翁4 重制版",
        "width": 1024,
        "height": 768,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "大富翁4 版权归 大宇资讯 / 软星科技 所有。本重制版为个人练习项目。",
    "shortDescription": "大富翁4 重制版",
    "longDescription": "大富翁4（1998，大宇/软星）的重制版。本仓库是 code-only 公开镜像，不含原版素材，打包也不附带任何游戏数据：运行前需自备原版《大富翁4》安装目录（见 docs/assets.md），程序会在运行时从该目录读取素材。"
  }
}
